+++++        ctypes.c_int,
+++++        ctypes.POINTER(ctypes.c_double),
+++++        ctypes.c_int,
+++++        ctypes.c_int,
+++++        ctypes.c_int,
+++++        ctypes.c_double,
+++++        ctypes.c_int,
+++++        ctypes.c_double,
+++++        ctypes.c_int,
+++++        ctypes.POINTER(ctypes.c_double),
+++++    ]
