++    /* Assemble: R = L2 · MF · L1 · brdf */
++    double L1[9], L2[9], MFL1[9], L2MFL1[9];
++    build_rotation_L(ci1, si1, L1);
++    build_rotation_L(ci2, si2, L2);
++    mat3_mul(MF, L1, MFL1);
++    mat3_mul(L2, MFL1, L2MFL1);
++    for (int i = 0; i < 9; ++i) R[i] = L2MFL1[i] * brdf;
