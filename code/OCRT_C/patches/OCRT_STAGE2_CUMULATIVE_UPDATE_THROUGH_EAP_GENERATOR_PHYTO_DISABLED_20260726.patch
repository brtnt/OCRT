++                        const double sm = W[((size_t)2*mm + 1) * (size_t)n_phi_quad + p];
++                        for (int kl = 0; kl < 9; kl++)
++                            acc[mm][kl] += R_local[kl] * (cos_entry[kl] ? cm : sm);
