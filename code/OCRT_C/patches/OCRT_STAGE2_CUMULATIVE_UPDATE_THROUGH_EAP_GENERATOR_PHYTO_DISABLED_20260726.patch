+++    double MT[9];
+++    mat3_zero(MT);
+++    double Q_kernel = (q_convention == 1) ? 0.5 * (ft_p - ft_s)
+++                                          : 0.5 * (ft_s - ft_p);
+++    MT[0*3+0] = 0.5 * (ft_s + ft_p);
+++    MT[0*3+1] = Q_kernel;
+++    MT[1*3+0] = Q_kernel;
+++    MT[1*3+1] = 0.5 * (ft_s + ft_p);
+++    MT[2*3+2] = ft_sp;
