++ * cross-section-weighted tail of the distribution. */
++#define RT_EAP_PSD_STEP_UM   0.05
++#define RT_EAP_PSD_MAX_MULT  5.5
++#define RT_EAP_V_EFF         0.6
++#define RT_EAP_N_MEDIA       1.334
++#define RT_EAP_ENDPOINT_TOL  1.0e-12
