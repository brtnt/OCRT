++        if (nu_v <= 20.0) {
++            lam_v = 0.5 * (exp(-nu_v * nu_v) / (nu_v * sqrt(M_PI)) - erfc(nu_v));
++        }
++    }
++    double S_bi = 1.0 / (1.0 + lam_i + lam_v);
