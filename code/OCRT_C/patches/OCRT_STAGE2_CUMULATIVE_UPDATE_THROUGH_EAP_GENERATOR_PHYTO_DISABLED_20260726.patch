+++++        and abs(r["raa_deg"] - raa) < 1.0e-12
+++++    ]
+++++    if len(hit) != 1:
+++++        raise RuntimeError(f"geometry vza={vza}, raa={raa}: rows={len(hit)}")
+++++    return hit[0]
