+grep -Fq 'const double cphi_r = -cphi;' src/shared/surface.c
+grep -Fq 'const double sphi_r = -sphi;' src/shared/surface.c
+grep -Fq 'const double mu_i_s = -mu_i;' src/shared/surface.c
