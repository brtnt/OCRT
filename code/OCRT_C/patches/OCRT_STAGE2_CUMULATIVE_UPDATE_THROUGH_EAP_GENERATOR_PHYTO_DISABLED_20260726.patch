++    if (mu_in_dn < 1.0 - 1e-10) {
++        double sin_i = sqrt(fmax(1e-20, 1.0 - mu_in_dn * mu_in_dn));
++        double nu_i = (mu_in_dn / sin_i) / sigma_len;
++        if (nu_i <= 20.0) {
