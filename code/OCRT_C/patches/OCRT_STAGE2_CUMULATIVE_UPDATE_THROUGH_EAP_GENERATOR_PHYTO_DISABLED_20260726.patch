+NORM_NM      = 675.0      # 논문 식 1. 공개 자료의 655 nm는 색인 오류로 규명됨
+HILBERT_NM   = (300.0, 1000.0, 1.0)   # 가장자리 오염 회피 (본 세션 판정)
+PSD_STEP_UM  = 0.05       # 수렴 확인: 0.10 um 이하에서 결과 동일
+PSD_MAX_MULT = 5.5        # 유효직경 배수
