+++    const double tan2 = (1.0 - hz*hz) / (hz*hz);
+++    const double D = exp(-tan2 / slope_variance) /
+++                     (M_PI * slope_variance * hz*hz*hz*hz);
+++    double denom = ih + n_water * oh;
+++    denom *= denom;
