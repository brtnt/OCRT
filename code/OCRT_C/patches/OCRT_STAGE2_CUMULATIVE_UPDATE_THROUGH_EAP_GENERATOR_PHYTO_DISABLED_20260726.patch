++    const double *theta_deg,
++    size_t n_theta,
++    double *p11,
++    double *p12,
++    double *p33
++);
++
++#ifdef __cplusplus
++} /* extern "C" */
++#endif
++
++#endif /* OCRT_RT_EAP_MIE_PHASE_H */
