+grep -Fq 'const double ruQ = ray_on ? -alpha2' src/rt_water_rt.c
+grep -Fq 'const double ruU = ray_on ? -alpha2' src/rt_water_rt.c
+
+echo 'PASS: stage-2 interface FIX1+FIX2+FIX3 + diffuse-top U-column source audit'
