++typedef void (*ocrt_fkc_trig_fn)(double, double, double, double,
++                                 double, int, double, int, double *);
++typedef struct {
++    int valid, n_o, n_i, n_phi, sigma_type, q_conv;
++    double ws, nw;
++    double *mu_o, *mu_i;
++    double *coef;                 /* (MMAX+1) slabs of n_o*n_i*9, m-major */
++} ocrt_fkc_t;
