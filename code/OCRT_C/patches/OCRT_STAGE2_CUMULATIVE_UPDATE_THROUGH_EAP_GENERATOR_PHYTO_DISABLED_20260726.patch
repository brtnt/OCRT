++        double t0 = theta[j] * M_PI / 180.0;
++        double t1 = theta[j + 1] * M_PI / 180.0;
++        s += 0.5 * (t1 - t0) * (p11[j] * sin(t0) + p11[j + 1] * sin(t1));
++    }
++    s *= 0.5;
++    if (fabs(s - 1.0) > 2.0e-12) {
++        fprintf(stderr, "normalization failure: %.17g\n", s);
++        return 1;
++    }
++    return 0;
++}
