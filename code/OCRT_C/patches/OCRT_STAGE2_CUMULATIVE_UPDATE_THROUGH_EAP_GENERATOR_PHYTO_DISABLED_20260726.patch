++        C->sigma_type = sigma_type; C->q_conv = q_convention;
++        C->ws = ws; C->nw = n_water; C->valid = 1;
++    }
++    memcpy(out_m, C->coef + (size_t)m * pair9, pair9 * sizeof(double));
++    return 1;
++}
