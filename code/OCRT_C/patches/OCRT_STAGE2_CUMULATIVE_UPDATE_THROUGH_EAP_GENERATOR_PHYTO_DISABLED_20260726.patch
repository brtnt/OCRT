+++                                  double mu_0, double phi_0,
+++                                  double ws, int sigma_type, double n_water,
+++                                  double tau_total, int q_convention,
+++                                  double *rho_glint) {
+++    double dphi = phi_v - phi_0;
+++    double cos_dphi = cos(dphi), sin_dphi = sin(dphi);
