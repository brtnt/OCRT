++++def parse_angles(path: Path) -> tuple[np.ndarray, np.ndarray]:
++++    pat = re.compile(
++++        r"\s*(\d+)\s+([+-]?\d+\.\d+D[+-]\d+)\s+"
++++        r"([+-]?\d+\.\d+D[+-]\d+)\s+(\d+)"
++++    )
++++    mu: list[float] = []
++++    wt: list[float] = []
++++    for line in path.read_text(errors="replace").splitlines():
++++        m = pat.match(line)
++++        if m:
++++            mu.append(float(m.group(2).replace("D", "E")))
++++            wt.append(float(m.group(3).replace("D", "E")))
