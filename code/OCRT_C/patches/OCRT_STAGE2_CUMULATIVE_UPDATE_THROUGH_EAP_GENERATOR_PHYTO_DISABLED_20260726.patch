++    /* Cox-Munk isotropic Gaussian slope */
++    double cos_beta_sq = cos_beta * cos_beta;
++    double tan_beta_sq = (1.0 - cos_beta_sq) / fmax(cos_beta_sq, 1e-8);
++    double P_slope = (1.0 / (M_PI * sigma_sq)) * exp(-tan_beta_sq / sigma_sq);
