+++        (B/A) * s2, s2,  (C/A) * c2
+++    };
+++    const int index[6] = {3,4,5,6,7,8};
+++
+++    double T[9] = {0};
+++    surface_T_aw_coxmunk_trig_test(mu_i, mu_o, cphi, sphi,
