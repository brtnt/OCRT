+    'Rhodophytes':[2,6,12,24,48], 'Synechococcus spp':[0.4,0.8,1.2,1.8],
+    'Microcystis-like (vacuolate)':[3,4,5,6],
+}
+if __name__ == '__main__':
+    n = sum(len(v) for v in DEFF_ALL.values())
+    print('종 %d개, 유효직경 조합 총 %d개' % (len(CATALOG), n))
