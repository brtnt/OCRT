++/* ----------------------------------------------------------------------------
++ * Generalized R / T Mueller matrices (Phase B.2 public API)
++ * ---------------------------------------------------------------------------- */
++void surface_flat_fresnel_R_matrix_general(double mu_i, double n1, double n2,
++                                            int q_convention, double *MR) {
