++    if (species_id >= RT_EAP_SPECIES_COUNT)
++        return RT_EAP_PHASE_ESPECIES;
++
++    if (fabs(theta_deg[0]) > RT_EAP_ENDPOINT_TOL) return RT_EAP_PHASE_ERANGE;
++    if (fabs(theta_deg[n_theta - 1] - 180.0) > RT_EAP_ENDPOINT_TOL)
