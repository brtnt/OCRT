++- double dphi = rt_raa_to_water_view_phi(cs->raa_deg);
+++ double dphi = rt_raa_to_atm_fourier_phi(cs->raa_deg);
++
++- double dvU = -rt_solver_reconstruct_phi_sin(...);
+++ double dvU =  rt_solver_reconstruct_phi_sin(...);
++```
