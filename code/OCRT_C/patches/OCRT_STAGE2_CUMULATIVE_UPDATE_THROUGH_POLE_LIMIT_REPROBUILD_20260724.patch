+-static int check_close(const char *name, double got, double expected, double tol) {
+-    const double err = fabs(got - expected);
+-    if (err > tol) {
+-        fprintf(stderr, "FAIL %s: got %.17g expected %.17g |d|=%.3e tol=%.3e\n",
+-                name, got, expected, err, tol);
+-        return 1;
+-    }
+-    return 0;
+-}
+-
+-static int run_offset(double offset_deg, const double expected[9]) {
+-    const double n = 1.34;
+-    const double theta_air = 40.0 * M_PI / 180.0;
+-    const double mu_air = cos(theta_air);
+-    const double sin_water = sin(theta_air) / n;
+-    const double mu_water = sqrt(fmax(0.0, 1.0 - sin_water * sin_water));
+-    const double phi = M_PI + offset_deg * M_PI / 180.0;
+-    double T[9] = {0};
+-
+-    surface_T_aw_coxmunk_trig_test(mu_air, mu_water, cos(phi), sin(phi),
+-                                    3.0, 1, n, 1, T);
+-    if (!(T[0] > 0.0)) {
+-        fprintf(stderr, "FAIL offset %.3f: non-positive M00 %.17g\n", offset_deg, T[0]);
+-        return 1;
+-    }
+-
+-    int failed = 0;
+-    for (int k = 0; k < 9; ++k) {
+-        char name[64];
+-        snprintf(name, sizeof(name), "offset=%+.2f M%d%d/M00",
+-                 offset_deg, k / 3 + 1, k % 3 + 1);
+-        failed |= check_close(name, T[k] / T[0], expected[k], 2.0e-10);
+-    }
+-    return failed;
+-}
+-
+-int main(void) {
+-    /* Independent analytic reference for physical incident propagation:
+-     * k_i=(-sin(theta_air),0,-mu_air),
+-     * k_o=(sin(theta_water)cos(phi), sin(theta_water)sin(phi),-mu_water).
+-     * Hence k_i dot k_o = mu_air*mu_water - sin_air*sin_water*cos(phi),
+-     * equivalent to using (cos(phi-pi),sin(phi-pi))=(-cphi,-sphi) in the
+-     * Hovenier/Mishchenko meridian rotations.  These nine ratios were obtained
+-     * from that vector-basis construction, not from OSOAA output. */
+-    const double plus[9] = {
+-        1.000000000000000e+00,
+-        1.810590544853932e-02,
+-       -1.410656414309412e-02,
+-        1.424992522504437e-02,
+-        9.714237870322705e-01,
+-        2.366686869713999e-01,
+-       -1.799329305922956e-02,
+-       -2.369321228452541e-01,
+-        9.714216946286109e-01
+-    };
+-    const double minus[9] = {
+-        1.000000000000000e+00,
+-        1.810590544853929e-02,
+-        1.410656414309413e-02,
+-        1.424992522504435e-02,
+-        9.714237870322705e-01,
+-       -2.366686869714000e-01,
+-        1.799329305922957e-02,
+-        2.369321228452541e-01,
+-        9.714216946286109e-01
+-    };
+-
+-    int failed = 0;
+-    failed |= run_offset(+8.25, plus);
+-    failed |= run_offset(-8.25, minus);
+-    if (failed) return EXIT_FAILURE;
+-
+-    puts("PASS: air-to-water microfacet meridian rotation analytic regression");
+-    return EXIT_SUCCESS;
+-}
