++static int close_value(const char *name, double got, double expected, double tol)
++{
++    const double err = fabs(got - expected);
++    if (err > tol) {
++        fprintf(stderr,
++                "FAIL %s got=%.17g expected=%.17g |d|=%.3e tol=%.3e\n",
++                name, got, expected, err, tol);
++        return 1;
++    }
