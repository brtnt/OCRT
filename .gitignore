# ============================================================================
# OCRT public repository — what stays OUT of git (kept on the local disk).
# See MIGRATION_README_2026-09-05_KO.md §3 for where each excluded item lives.
# ============================================================================

# deliveries / archives / campaign outputs (multi-GB)
/package/
/task/

# unpublished manuscript (LaTeX, PDF, figures) — local only until publication
/docs/paper/

# third-party code and data (not ours to redistribute): OSOAA (CNES) working copy,
# RTSOS-derived driver files and benchmark inputs used for the IPSS cross-check
/code/OSOAA/
/code/OCRT_C/validation/ipss_2026-09-05/xcheck_rtsos/main_*.f90
/code/OCRT_C/validation/ipss_2026-09-05/xcheck_rtsos/*/ray.pmtx
/code/OCRT_C/validation/ipss_2026-09-05/xcheck_rtsos/*/auxiliary_directory

# large scientific data: the 181 Mie tables (4.3 GB) are distributed as GitHub Release assets
# (see MIGRATION_README §3 / scripts/fetch_data.sh); small data files stay in git
*.mie
!/code/OCRT_C/tests/fixtures/*.mie
/code/validation_05/runs/
*.gz
*.zip
*.tar
*.7z

# build products and binaries (rebuild from source; see code/OCRT_C/REBUILD_WIN_*.txt)
build/
_RELEASE/
*.o
*.obj
*.exe
*.dll
*.so
__pycache__/
*.pyc

# local credentials — never commit
/.github_token
.git-credentials

# OS / editor noise
Thumbs.db
.DS_Store
desktop.ini
*.swp

# probe files
.perm_probe
