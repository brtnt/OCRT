+def vector_beamq_fourier_allm(rm, n_mu, m_count, phase, nphi):
+    """Exact incoming-Q solar column, returned as I<-Q, Q<-Q, U<-Q.
+
+    Each array has shape ``[m, k+n_mu]``.  The U column follows the existing
+    OCRT primary-source sign convention and therefore accumulates ``-Z[7]``.
+    """
+    nphi = max(16, min(20000, int(nphi)))
+    kw = 2 * n_mu + 1
+    out_i = np.zeros((m_count, kw))
+    out_q = np.zeros((m_count, kw))
+    out_u = np.zeros((m_count, kw))
+    phis = 2 * pi * (np.arange(nphi) + 0.5) / nphi
+    cp = np.cos(phis)
+    sp = np.sin(phis)
+    ms = np.arange(m_count)
+    cosm = np.cos(ms[:, None] * phis[None, :])
+    sinm = np.sin(ms[:, None] * phis[None, :])
+    mui = rm[n_mu]
+    si = sqrt(max(0.0, 1.0 - mui * mui))
+    for ko, k in enumerate(range(-n_mu, n_mu + 1)):
+        if k == 0:
+            continue
+        muo = rm[k + n_mu]
+        so = sqrt(max(0.0, 1.0 - muo * muo))
+        cth = np.clip(mui * muo + si * so * cp, -1.0, 1.0)
+        sth = np.sqrt(np.maximum(0.0, 1.0 - cth * cth))
+        p11v, p12v, p33v = phase.eval(cth)
+        ciq = np.zeros(m_count)
+        cqq = np.zeros(m_count)
+        suq = np.zeros(m_count)
+        for iq in range(nphi):
+            p11 = float(p11v[iq]); p12 = float(p12v[iq]); p33 = float(p33v[iq])
+            P = np.array([p11, p12, 0.0, p12, p11, 0.0, 0.0, 0.0, p33])
+            ci1, si1, ci2, si2 = _hovenier(
+                muo, mui, so, si, float(cth[iq]), float(sth[iq]), float(sp[iq]))
+            Z = mat3_mul(build_rotation_L(ci2, si2),
+                         mat3_mul(P, build_rotation_L(ci1, si1)))
+            ciq += Z[1] * cosm[:, iq]
+            cqq += Z[4] * cosm[:, iq]
+            suq += (-Z[7]) * sinm[:, iq]
+        out_i[:, ko] = ciq / nphi
+        out_q[:, ko] = cqq / nphi
+        out_u[:, ko] = suq / nphi
+    return out_i, out_q, out_u
